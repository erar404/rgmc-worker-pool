# BC OAuth2
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_TENANT_ID=
BC_SCOPE=https://api.businesscentral.dynamics.com/.default
BC_ENVIRONMENT=Production
BC_COMPANY=RGMC
BC_COMPANIES=RGMC

# GCP
GCP_PROJECT_ID=your-project-id
GCP_ENV=Production
GCS_CATALOG_BUCKET=rgmc-bc-catalog-your-project-id

# Pub/Sub subscriptions (pull — this worker pool consumes these)
PUBSUB_ORDER_SUBSCRIPTION=rgmc-orders-worker-sub
PUBSUB_SYNC_SUBSCRIPTION=rgmc-sync-worker-sub

# Pub/Sub topics (published to by the main API and Cloud Scheduler)
PUBSUB_ORDER_TOPIC=rgmc-orders
PUBSUB_SYNC_TOPIC=rgmc-sync

# Error notification email (leave blank to disable)
DEVELOPER_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
